# 服务监听端口
PORT=4100

# 角色分身标识（不同角色独立存储与向量分区）
PERSONA_ID=default

# 决策模式：jev（优先尝试本地 2070 Jev，超时降级） | inline（仅走双流标签）
AFFECT_MODE=inline

# 本地 System 1 Jev 决策引擎（RTX 2070 llama-server）
LOCAL_JEV_URL=http://127.0.0.1:8081/v1
LOCAL_JEV_TIMEOUT_MS=450

# 云端 System 2 大模型配置 (支持 DeepSeek / Claude / Qwen / OpenAI 等兼容协议)
CLOUD_API_KEY=your_api_key_here
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=gemini-3.8-flash

# 客户端联网搜索凭据 (供 DeepSeek Harness 等第三方网关客户端内置搜索插件使用)
DEEPSEEK_API_KEY=

# HuggingFace 模型镜像加速
HF_MIRROR=https://hf-mirror.com
